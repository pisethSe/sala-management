# Copy to .env.local and fill in your own values.
# Supabase PostgreSQL. URL-encode special characters in the password.
# Local dev uses the Session pooler (5432); serverless deploys use the Transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379
PORT=3001
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional: legacy HS256 secret (Supabase dashboard → Settings → API → JWT Secret).
# Not needed for projects signing with asymmetric keys (verified via JWKS).
SUPABASE_JWT_SECRET=
